local function CreateTab(name, order)
	local button = New("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(112, 36),
		BackgroundColor3 = Color3.fromRGB(35, 35, 43),
		Text = name,
		TextColor3 = Color3.fromRGB(180, 180, 190),
		TextSize = 12,
		Font = Enum.Font.GothamSemibold,
		AutoButtonColor = false,
		LayoutOrder = order,
		ZIndex = 13
	}, TabBar)

	Corner(button, 8)

	local frame = New("Frame", {
		Name = name .. "_Content",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 12
	}, Content)

	New("UIListLayout", {
		Padding = UDim.new(0, 9),
		SortOrder = Enum.SortOrder.LayoutOrder
	}, frame)

	Padding(frame, 4, 4, 4, 8)

	Tabs[name] = {
		Button = button,
		Frame = frame
	}

	button.MouseButton1Click:Connect(function()
		for _, data in pairs(Tabs) do
			data.Frame.Visible = false
			data.Button.BackgroundColor3 = Color3.fromRGB(35, 35, 43)
			data.Button.TextColor3 = Color3.fromRGB(180, 180, 190)
		end

		frame.Visible = true
		button.BackgroundColor3 = Color3.fromRGB(65, 65, 80)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		Content.CanvasPosition = Vector2.new(0, 0)
	end)

	return frame
end


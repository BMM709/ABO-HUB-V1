local function ClampMain()
	local viewport = Camera.ViewportSize
	local size = Main.AbsoluteSize
	local pos = Main.AbsolutePosition
	local margin = 8

	local minX = margin
	local minY = margin
	local maxX = math.max(minX, viewport.X - size.X - margin)
	local maxY = math.max(minY, viewport.Y - size.Y - margin)

	local x = math.clamp(pos.X, minX, maxX)
	local y = math.clamp(pos.Y, minY, maxY)

	Main.Position = UDim2.fromOffset(x + size.X / 2, y + size.Y / 2)
end

local function UpdateLayout()
	local viewport = Camera.ViewportSize

	if viewport.X <= 700 then
		local w = math.floor(viewport.X * 0.94)
		local h = math.floor(viewport.Y * 0.84)

		w = math.max(300, math.min(w, 600))
		h = math.max(330, math.min(h, 650))

		Main.Size = UDim2.fromOffset(w, h)
	else
		Main.Size = UDim2.fromOffset(
			math.min(560, viewport.X - 40),
			math.min(430, viewport.Y - 40)
		)
	end

	Main.Position = UDim2.new(0.5, 0, 0.5, 0)

	task.defer(ClampMain)
end

UpdateLayout()


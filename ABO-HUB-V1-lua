FunTab:Toggle({
    Title = "Rainbow Character",
    Desc = "เปลี่ยนสีตัวละครแบบสายรุ้ง",
    Default = false,
    Callback = function(Value)
        Settings.Rainbow = Value
        if Connections.Rainbow then
            Connections.Rainbow:Disconnect()
            Connections.Rainbow = nil
        end

        if Value then
            Connections.Rainbow = RunService.RenderStepped:Connect(function()
                local Character = GetCharacter()
                -- [แก้ไขบัคตรงนี้แล้ว]
                if not Character then return end

                local Hue = (os.clock() % 5) / 5
                for _, Object in ipairs(Character:GetDescendants()) do
                    if Object:IsA("BasePart") then
                        Object.Color = Color3.fromHSV(Hue, 0.8, 1)
                    end
                end
            end)
        end
    end
})


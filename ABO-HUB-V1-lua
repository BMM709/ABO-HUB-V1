            end)
        end
    end
})

FunTab:Toggle({
    Title = "ไฟบนหัว",
    Desc = "สร้างไฟบนหัวตัวละคร",
    Default = false,
    Callback = function(Value)
        local Character = GetCharacter()
        local Head = Character and Character:FindFirstChild("Head")
        if not Head then return end

        local Old = Head:FindFirstChild("ABOHeadLight")
        if Value then
            if not Old then
                local Light = Instance.new("PointLight")
                Light.Name = "ABOHeadLight"
                Light.Brightness = 2
                Light.Range = 20
                Light.Parent = Head
            end
        elseif Old then
            Old:Destroy()
        end
    end
})

FunTab:Toggle({
    Title = "Highlight ตัวละคร",
    Desc = "ทำให้ตัวละครมีขอบเรืองแสง",

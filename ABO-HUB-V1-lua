local function Toggle(parent, text, default, callback)
	local value = default

	local button = New("TextButton", {
		Size = UDim2.new(1, -8, 0, 44),
		BackgroundColor3 = Color3.fromRGB(32, 32, 40),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = #parent:GetChildren() + 1
	}, parent)

	Corner(button, 9)
	Stroke(button, 1, 0.35)

	New("TextLabel", {
		Size = UDim2.new(1, -75, 1, 0),
		Position = UDim2.new(0, 14, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(235, 235, 240),
		TextSize = 13,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left
	}, button)

	local switch = New("Frame", {
		Size = UDim2.fromOffset(42, 22),
		Position = UDim2.new(1, -55, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(65, 65, 72)
	}, button)

	Corner(switch, 12)

	local dot = New("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(0, 2, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(220, 220, 225)
	}, switch)

	Corner(dot, 10)

	local function Update()
		if value then
			switch.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
			dot.Position = UDim2.new(1, -20, 0.5, -9)
		else
			switch.BackgroundColor3 = Color3.fromRGB(65, 65, 72)
			dot.Position = UDim2.new(0, 2, 0.5, -9)
		end

		if callback then
			callback(value)
		end
	end

	button.MouseButton1Click:Connect(function()
		value = not value
		Update()
	end)

	Update()

	return {
		Set = function(v)
			value  = v
			Update()
		end,
		Get = function()
			return value
		end
	}
end

local function Slider(parent, text, min, max, default, callback)
	local value = default

	local holder = New("Frame", {
		Size = UDim2.new(1, -8, 0, 68),
		BackgroundColor3 = Color3.fromRGB(30, 30, 38),
		LayoutOrder = #parent:GetChildren() + 1
	}, parent)

	Corner(holder, 9)

	New("TextLabel", {
		Size = UDim2.new(1, -80, 0, 27),
		Position = UDim2.new(0, 12, 0, 4),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(230, 230, 235),
		TextSize = 12,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left
	}, holder)

	local valueLabel = New("TextLabel", {
		Size = UDim2.new(0, 65, 0, 27),
		Position = UDim2.new(1, -72, 0, 4),
		BackgroundTransparency = 1,
		Text = tostring(default),
		TextColor3 = Color3.fromRGB(120, 220, 255),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Right
	}, holder)

	local bar = New("TextButton", {
		Size = UDim2.new(1, -24, 0, 14),
		Position = UDim2.new(0, 12, 0, 43),
		BackgroundColor3 = Color3.fromRGB(55, 55, 65),
		Text = "",
		AutoButtonColor = false,
		Active = true
	}, holder)

	Corner(bar, 7)

	local fill = New("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(90, 190, 255),
		BorderSizePixel = 0
	}, bar)

	Corner(fill, 7)

	local knob = New("Frame", {
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0)
	}, bar)

	Corner(knob, 10)

	local dragging = false

	local function SetValueFromX(x)
		if bar.AbsoluteSize.X <= 0 then
			return
		end

		local relative = math.clamp(
			x - bar.AbsolutePosition.X,
			0,
			bar.AbsoluteSize.X
		)

		local percent = relative / bar.AbsoluteSize.X

		value = min + (max - min) * percent

		if math.abs(value - math.floor(value)) < 0.01 then
			value = math.floor(value)
		else
			value = math.floor(value * 10 + 0.5) / 10
		end

		local p = (value - min) / (max - min)

		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		valueLabel.Text = tostring(value)

		if callback then
			callback(value)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			SetValueFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			SetValueFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	task.defer(function()
		if bar.AbsoluteSize.X > 0 then
			SetValueFromX(
				bar.AbsolutePosition.X
				+ ((default - min) / (max - min)) * bar.AbsoluteSize.X
			)
		end
	end)

	return {
		Set = function(v)
			value = math.clamp(v, min, max)

			local p = (value - min) / (max - min)

			fill.Size = UDim2.new(p, 0, 1, 0)
			knob.Position = UDim2.new(p, 0, 0.5, 0)
			valueLabel.Text = tostring(value)

			if callback then
				callback(value)
			end
		end,

		Get = function()
			return value
		end
	}
end

local function GetCharacter()
	return Player.Character
end

local function GetHumanoid()
	local char = GetCharacter()
	if char then
		return char:FindFirstChildOfClass("Humanoid")
	end
end

local function ApplyMovement()
	local hum = GetHumanoid()

	if hum then
		hum.WalkSpeed = Settings.WalkSpeed
		hum.UseJumpPower = true
		hum.JumpPower = Settings.JumpPower
	end

	workspace.Gravity = Settings.Gravity
end

local function ApplyFOV()
	if Camera then
		Camera.FieldOfView = Settings.FOV
	end
end

local function ApplyFullbright()
	if Settings.Fullbright then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		Lighting.Ambient = Color3.fromRGB(255, 255, 255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
	else
		Lighting.Brightness = OriginalLighting.Brightness
		Lighting.ClockTime = OriginalLighting.ClockTime
		Lighting.FogEnd = OriginalLighting.FogEnd
		Lighting.FogStart = OriginalLighting.FogStart
		Lighting.Ambient = OriginalLighting.Ambient
		Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
	end
end

local function ApplyNoFog()
	if Settings.NoFog then
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
	else
		Lighting.FogEnd = OriginalLighting.FogEnd
		Lighting.FogStart = OriginalLighting.FogStart
	end
end

local function ClearHighlights()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Highlight") and obj.Name == "ABO_Highlight" then
			obj:Destroy()
		end
	end
end

local function ApplyHighlight()
	ClearHighlights()

	if not Settings.Highlight then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Player and player.Character then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ABO_Highlight"
			highlight.FillTransparency = 0.55
			highlight.OutlineTransparency = 0
			highlight.Parent = player.Character
		end
	end
end

